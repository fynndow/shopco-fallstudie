{
  "name": "shopco",
  "version": "1.0.0",
  "description": "ShopCo E-Commerce Plattform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "echo 'Build backend (nichts zu kompilieren)' && npm run prisma:generate",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:ci": "jest --coverage --runInBand --reporters=default --reporters=jest-junit",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --headless",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force --skip-seed",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "helmet": "7.2.0",
    "jsonwebtoken": "9.0.2",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "cypress": "13.15.2",
    "jest": "29.7.0",
    "jest-junit": "16.0.0",
    "nock": "13.5.5",
    "nodemon": "3.1.7",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "undici": "^6.20.1"
  },
  "engines": {
    "node": ">=20"
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml"
  }
}
